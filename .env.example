# 模型：DeepSeek 的 Anthropic 兼容入口
# 注意末尾要带 /v1：AI SDK 的 Anthropic provider 把 baseURL 当作 ".../v1" 使用
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic/v1
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# deepseek-v4-flash 是旧名，官方当前名是 deepseek-flash。旧名仍被接受，
# 但底层已由 DeepSeek-V4.1-Flash 提供服务。可用模型见 GET /v1/models。
DEEPSEEK_MODEL=deepseek-v4-flash
# 上下文窗口。DeepSeek 标称 1048576（1Mi）。写小了会让 eve 过早触发上下文压缩。
DEEPSEEK_CONTEXT_WINDOW=1048576
# 单次输出上限。AI SDK 不认识 DeepSeek 的模型名，不显式指定会被压到 4096。
# DeepSeek 侧上限 393216，这里默认 16384。
DEEPSEEK_MAX_OUTPUT_TOKENS=16384

# 状态存储：OrbStack 里跑的 Redis
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=eve-agent

# 生产 / 自托管鉴权（eve dev 不需要，localDev() 会放行）
# 配了 EVE_AUTH_TOKEN 就用 Bearer 校验；没配则拒绝所有生产请求。
# EVE_AUTH_MODE=none 表示完全不鉴权，只在确认流量可以公开时用。
# EVE_AUTH_TOKEN=换成一段足够长的随机字符串
# EVE_AUTH_MODE=none
